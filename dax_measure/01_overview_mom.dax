// ======================================================================
// Overview page: month-over-month comparison + conditional-formatting colours
// Project  : Sales Performance Dashboard (Power BI)
// Table    : _Measures
// Notes    : PM = previous month (DATEADD -1 MONTH). '<X> MoM %' returns TEXT with an up/down arrow (UNICHAR 11165 / 11167) for KPI cards. 'CF ...' measures return a colour name for conditional formatting.
// Usage    : Power BI Desktop > Modeling > New measure (paste one measure at a time),
//            or load the whole file with Tabular Editor / DAX Studio.
// ======================================================================

// ----------------------------------------------------------------------
// Measure : Total Orders PM
// Folder  : 01 Overview\MoM
// ----------------------------------------------------------------------
Total Orders PM =
    CALCULATE([Total Orders], DATEADD(dim_date[Date], -1, MONTH))

// ----------------------------------------------------------------------
// Measure : Orders MoM %
// Folder  : 01 Overview\MoM
// ----------------------------------------------------------------------
Orders MoM % =
    VAR _CM = [Total Orders]
    VAR _PM = CALCULATE(
        [Total Orders], DATEADD(dim_date[Date], -1, MONTH)
    )
    VAR _perc = DIVIDE(_CM - _PM, _PM)
    VAR _format = SWITCH(
        TRUE(),
        _perc > 0, UNICHAR(11165) & " " & FORMAT(_perc, "0.0%"),
        _perc < 0, UNICHAR(11167) & " " & FORMAT(_perc*-1, "0.0%"),
        FORMAT(_perc, "0.0%")
    )
    RETURN
    _format

